VITE_EMAILJS_SERVICE_ID=service_p9ugz8s
VITE_EMAILJS_TEMPLATE_ID=template_kfbhiz4
VITE_EMAILJS_PUBLIC_KEY=

# --- Ask Vishnu AI (server-side only) ----------------------------------------
# NEVER prefix these with VITE_. Vite inlines every VITE_* variable into the
# public bundle, which would hand the Gemini key to anyone with DevTools.
# On Vercel these are set under Project Settings → Environment Variables.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash is closed to new keys. gemini-flash-latest also works but
# auto-updates; pin a version so answers don't change without a deploy.
GEMINI_MODEL=gemini-3.7-flash

# Quota. 10 questions per visitor per day, resetting at 00:00 IST.
CHAT_DAILY_LIMIT=10
CHAT_GLOBAL_DAILY_LIMIT=500
# Any random string. Salts the visitor hash so IPs are never stored.
QUOTA_SALT=

# Quota store. Without these the limit falls back to per-instance memory, which
# is fine for local dev but must be set before launch (Vercel KV or Upstash).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Extra origins allowed to call /api/chat. Same-origin and localhost always pass.
ALLOWED_ORIGINS=

# --- Session replay (web-analytics) -----------------------------------------
# Both are safe to expose: the URL is public and the write key authorises
# writes to the ingest endpoint only, never reads. The endpoint additionally
# checks the Origin, which is what actually protects it.
#
# Leave BOTH unset and the whole feature is inert: no rrweb download, no
# consent banner, no requests. That is the intended state for forks and
# preview deploys.
#
# The path is /api/v1/ingest. The backend is Spring Boot and the controller is
# @RequestMapping("/api/v1/ingest") — /api/ingest is from the earlier Vercel
# implementation and no longer exists.
#
# vishnubaalan.com is not an owned domain — there is no custom domain for the
# backend. Point this at wherever it's actually hosted (e.g. a Render/Fly/
# Railway URL) plus the path above.
VITE_ANALYTICS_URL=https://<your-web-analytics-backend-host>/api/v1/ingest
# Must equal INGEST_WRITE_KEY (analytics.ingest.write-key) on the backend.
VITE_ANALYTICS_WRITE_KEY=

# Records during `npm run dev` when set to 1. Off by default so the developer's
# own reloads do not fill the triage queue; turn it on to verify the wiring
# against a locally running backend.
VITE_ANALYTICS_DEV=0
