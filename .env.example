VITE_EMAILJS_SERVICE_ID=service_p9ugz8s
VITE_EMAILJS_TEMPLATE_ID=template_kfbhiz4
VITE_EMAILJS_PUBLIC_KEY=

# --- Ask Vishnu AI (server-side only) ----------------------------------------
# NEVER prefix these with VITE_. Vite inlines every VITE_* variable into the
# public bundle, which would hand the Gemini key to anyone with DevTools.
# On Vercel these are set under Project Settings → Environment Variables.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash is closed to new keys. gemini-flash-latest also works but
# auto-updates; pin a version so answers don't change without a deploy.
GEMINI_MODEL=gemini-3.7-flash

# Quota. 10 questions per visitor per day, resetting at 00:00 IST.
CHAT_DAILY_LIMIT=10
CHAT_GLOBAL_DAILY_LIMIT=500
# Any random string. Salts the visitor hash so IPs are never stored.
QUOTA_SALT=

# Quota store. Without these the limit falls back to per-instance memory, which
# is fine for local dev but must be set before launch (Vercel KV or Upstash).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Extra origins allowed to call /api/chat. Same-origin and localhost always pass.
ALLOWED_ORIGINS=
